<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sources of Runtime/ with what a Unity 6000.0 Editor compiles them with: C# 9 on
    netstandard2.1, against the assemblies in Runtime/Plugins and nothing else. So newer C#, or
    an API that only .NET has, fails here and not in the Editor of a user.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenRoIS.Sdk</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs" />
    <Reference Include="../../Runtime/Plugins/*.dll" />
  </ItemGroup>

  <!-- Named here, so that the package itself shows no test assembly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="OpenRoIS.Sdk.Core.Tests" />
  </ItemGroup>

</Project>
