{
  "name": "@openrois/interfaces",
  "version": "0.1.0",
  "description": "RoIS Framework 2.0 interface types for the OpenRoIS middleware",
  "license": "Apache-2.0",
  "author": "OpenRoIS Community",
  "keywords": [
    "rois",
    "omg",
    "robotics",
    "hri",
    "middleware"
  ],
  "homepage": "https://openrois.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openrois/openrois",
    "directory": "interfaces/typescript"
  },
  "bugs": {
    "url": "https://github.com/openrois/openrois/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hri": {
      "types": "./dist/hri.d.ts",
      "default": "./dist/hri.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "default": "./dist/profiles.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./condition": {
      "types": "./dist/condition.d.ts",
      "default": "./dist/condition.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "default": "./dist/values.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "tsx": "^4.7.0"
  }
}
